# devbox.yaml.tmpl — Lima VM template.
# Rendered by ./up.sh into devbox[.<profile>].yaml (gitignored) via envsubst.
#
# Do not edit the rendered YAML directly — edit this template and re-run ./up.sh.
# See README.md for the variable list.

vmType: "vz"           # macOS Virtualization.framework — fast, low overhead on Apple Silicon

images:
  - location: "https://cloud-images.ubuntu.com/releases/${UBUNTU_VERSION}/release/ubuntu-${UBUNTU_VERSION}-server-cloudimg-amd64.img"
    arch: "x86_64"
  - location: "https://cloud-images.ubuntu.com/releases/${UBUNTU_VERSION}/release/ubuntu-${UBUNTU_VERSION}-server-cloudimg-arm64.img"
    arch: "aarch64"

cpus: ${CPUS}
memory: "${MEMORY}"
disk: "${DISK}"

mounts:
  # This profile's project code. Different profiles point at different Mac
  # subdirs to keep contexts isolated.
  - location: "${DEV_ROOT}"
    mountPoint: "/mnt/dev"
    writable: true
  # devbox repo itself — Lima's user-mode provision hook reads provision.sh
  # from here. Same path across every profile; only /mnt/dev differs.
  - location: "${PROVISION_ROOT}"
    mountPoint: "/mnt/tooling"
    writable: false
  # Per-profile state that must outlive the VM disk: Claude Code sessions and
  # login (CLAUDE_CONFIG_DIR points at /mnt/state/claude). nuke.sh deletes the
  # disk, never this. Created by up.sh if absent.
  - location: "${STATE_ROOT}"
    mountPoint: "/mnt/state"
    writable: true

mountType: "virtiofs"  # fastest option on Apple Silicon; requires vmType=vz

ssh:
  loadDotSSHPubKeys: true   # ~/.ssh/*.pub is added to the VM's authorized_keys
  forwardAgent: true        # SSH-agent forwarding: `git push` in the VM uses
                            # the Mac's key without copying it in

# Environment variables set at provision time so provision.sh can read them.
env:
  RUST_VERSION: "${RUST_VERSION}"
  NODE_VERSION: "${NODE_VERSION}"
  LAZYGIT_VERSION: "${LAZYGIT_VERSION}"
  DOTFILES_REPO: "${DOTFILES_REPO}"
  NVIM_CONFIG_REPO: "${NVIM_CONFIG_REPO}"
  # Per-profile tool opt-ins. Empty renders as "" and provision.sh treats that
  # as off/default, so a profile .env that predates them still works.
  INSTALL_FLYCTL: "${INSTALL_FLYCTL}"
  FLYCTL_VERSION: "${FLYCTL_VERSION}"

# Provisioning runs on first boot. provision.sh is idempotent — safe to re-run.
provision:
  # System-wide setup (root).
  - mode: system
    script: |
      #!/usr/bin/env bash
      set -euxo pipefail
      export DEBIAN_FRONTEND=noninteractive
      apt-get update
      # bubblewrap: rootless sandbox binary. Claude Code's own Bash sandbox
      # uses it on Linux and silently runs unsandboxed without it. (It used to
      # come in as an ai-jail dependency, which this VM no longer installs.)
      apt-get install -y \
        build-essential curl git unzip ca-certificates \
        ripgrep fd-find \
        zsh \
        xclip \
        pkg-config libssl-dev \
        bubblewrap
      # Ubuntu ships fd as `fdfind`; add a `fd` alias binary.
      ln -sf /usr/bin/fdfind /usr/local/bin/fd || true

  # User-level setup runs the mounted provision.sh, which does all the heavy
  # lifting (rustup, mise, node, neovim, dotfiles, agents) in a normal shell
  # file that is easier to read and debug than YAML-embedded here-docs.
  - mode: user
    script: |
      #!/usr/bin/env bash
      set -euxo pipefail
      if [ -f /mnt/tooling/provision.sh ]; then
        bash /mnt/tooling/provision.sh
      else
        echo "[provision] /mnt/tooling/provision.sh not found — PROVISION_ROOT wrong?"
        exit 1
      fi
