# devbox.env — machine-local Lima VM config.
#
# Copy to devbox.env (default profile) or devbox.<profile>.env (extra profile,
# e.g. devbox.sunne.env). Both are gitignored — edit for this machine.
#
# Paths must exist on the Mac host BEFORE `./up.sh`. Lima refuses to mount
# non-existent locations.

# --- Identity ---
# The Lima VM name. Must be unique across profiles on this Mac.
VM_NAME="devbox"

# --- Resources ---
# Sized for a 16 GiB M-series Mac running two VMs in parallel. Bump these on
# bigger hardware; drop CPUS to 1 on 8 GiB machines if you also run browsers.
CPUS="2"
MEMORY="4GiB"
DISK="60GiB"

# --- Base image ---
UBUNTU_VERSION="24.04"

# --- Pinned runtime versions (baked into the VM by provision.sh) ---
RUST_VERSION="1.96.0"
NODE_VERSION="22.11.0"
LAZYGIT_VERSION="0.63.0"

# --- Mounts: Mac paths → VM paths ---
# DEV_ROOT: where THIS profile's project code lives on the Mac. Mounted at
# /mnt/dev inside the VM. Two profiles pointing at different subdirectories
# is how one physical Mac hosts two isolated dev contexts.
DEV_ROOT="${HOME}/Documents/dev"

# PROVISION_ROOT: where the devbox repo itself lives on the Mac. Mounted at
# /mnt/tooling. This is the path Lima reads provision.sh from — every
# profile needs it, and it can be the same directory across profiles.
PROVISION_ROOT="${HOME}/Documents/dev/devbox"

# DOTFILES_ROOT: your dotfiles repo on the Mac. Mounted read-only.
# Provision clones from GitHub if this doesn't exist; mount is optional.
DOTFILES_ROOT="${HOME}/Documents/dev/dotfiles"

# NVIM_CONFIG_ROOT: your nvim config repo on the Mac. Mounted read-only.
# Provision clones from GitHub if this doesn't exist; mount is optional.
NVIM_CONFIG_ROOT="${HOME}/Documents/dev/nvim-config"

# --- GitHub identities (used by provision to clone repos it can't find locally) ---
DOTFILES_REPO="https://github.com/HenriqueArtur/dotfiles.git"
NVIM_CONFIG_REPO="https://github.com/HenriqueArtur/nvim-config.git"
